#!name = HBO Max Highest Quality on iPad
#!desc = Experimental chapter-aware quality: retain pre-roll choices, force the highest available main video and same-language audio. Rewrites playback identity; does not use the low-quality fallback.
#!author = JerseyRiver
#!version = 1.2.0

[Script]
http-request ^https:\/\/default\.any-any\.prd\.api\.discomax\.com\/playback-orchestrator\/any\/playback-orchestrator\/v1\/playbackInfo(?:\?|$) script-path=https://raw.githubusercontent.com/JerseyRiver/hbo-max-ipad-highest-quality/main/hbo-playback.request.js?v=1.2.0, requires-body=1, timeout=10, tag=HBO iPad Playback
http-response ^https:\/\/default\.any-any\.prd\.api\.discomax\.com\/playback-orchestrator\/any\/playback-orchestrator\/v1\/playbackInfo(?:\?|$) script-path=https://raw.githubusercontent.com/JerseyRiver/hbo-max-ipad-highest-quality/main/hbo-period-plan.response.js?v=1.2.0, requires-body=1, timeout=10, tag=HBO iPad Chapter Plan
http-response ^https:\/\/[^/?#]+\/[^?#]+\.m3u8(?:\?|$) script-path=https://raw.githubusercontent.com/JerseyRiver/hbo-max-ipad-highest-quality/main/hbo-period-quality.response.js?v=1.2.0, requires-body=1, timeout=10, tag=HBO iPad Chapter Quality

[MITM]
hostname = default.any-any.prd.api.discomax.com, *.e.hbo, *.media.max.com, *.media.h264.io
