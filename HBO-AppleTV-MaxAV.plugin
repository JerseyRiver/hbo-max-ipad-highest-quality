#!name = HBO Apple TV + 最高画质与音频
#!desc = 播放申请使用 Apple TV 身份；主清单只保留最高视频档位及优先音频组（Atmos、EAC3、AC3、AAC）。
#!author = sanyue025-create
#!version = 1.0.0

[Script]
http-request ^https:\/\/default\.any-any\.prd\.api\.discomax\.com\/playback-orchestrator\/any\/playback-orchestrator\/v1\/playbackInfo(?:\?|$) script-path=https://raw.githubusercontent.com/sanyue025-create/hbo-appletv-maxav-loon/main/hbo-appletv.request.js, requires-body=1, timeout=10, tag=HBO AppleTV 身份实验
http-response ^https:\/\/[^/?#]+\/(?:[^?#]*\/)?hls\.m3u8(?:\?|$) script-path=https://raw.githubusercontent.com/sanyue025-create/hbo-appletv-maxav-loon/main/hbo-max-av.response.js, requires-body=1, timeout=10, tag=HBO 最高画质与音频锁定

[MITM]
hostname = default.any-any.prd.api.discomax.com, *.e.hbo, *.media.max.com, *.media.h264.io
