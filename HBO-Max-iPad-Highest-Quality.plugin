#!name = HBO Max Highest Quality on iPad
#!desc = For HBO Max on iPad when the app does not select the highest quality. Rewrites playback identity, locks the highest available video tier and prefers Dolby Atmos audio. Uses a server-provided main-only fallback when available.
#!author = JerseyRiver
#!version = 1.1.0

[Script]
http-request ^https:\/\/default\.any-any\.prd\.api\.discomax\.com\/playback-orchestrator\/any\/playback-orchestrator\/v1\/playbackInfo(?:\?|$) script-path=https://raw.githubusercontent.com/JerseyRiver/hbo-max-ipad-highest-quality/main/hbo-playback.request.js?v=1.1.0, requires-body=1, timeout=10, tag=HBO iPad Playback
http-response ^https:\/\/default\.any-any\.prd\.api\.discomax\.com\/playback-orchestrator\/any\/playback-orchestrator\/v1\/playbackInfo(?:\?|$) script-path=https://raw.githubusercontent.com/JerseyRiver/hbo-max-ipad-highest-quality/main/hbo-main-only.response.js?v=1.1.0, requires-body=1, timeout=10, tag=HBO iPad Main Only
http-response ^https:\/\/[^/?#]+\/(?:[^?#]*\/)?(?:hls|[^/?#]+_fallback)\.m3u8(?:\?|$) script-path=https://raw.githubusercontent.com/JerseyRiver/hbo-max-ipad-highest-quality/main/hbo-highest-quality.response.js?v=1.1.0, requires-body=1, timeout=10, tag=HBO Highest Video and Audio

[MITM]
hostname = default.any-any.prd.api.discomax.com, *.e.hbo, *.media.max.com, *.media.h264.io
